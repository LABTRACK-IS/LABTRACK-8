# ==============================================================================
# LabTrack Backend Environment Template
# Copy to `.env` for Docker Compose or configure per-service configs locally.
# ==============================================================================

# Environment
ASPNETCORE_ENVIRONMENT=Development
PYTHON_ENV=development

# Ports
GATEWAY_PORT=80
API_PORT=8080
AI_ENGINE_PORT=8000
DB_PORT=5432

# PostgreSQL (pgvector/pgvector:pg16)
POSTGRES_DB=labtrack_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Python AI Engine (Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
LLM_DEFAULT_MODEL=gemini-2.5-flash
